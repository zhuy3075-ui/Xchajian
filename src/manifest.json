{
  "manifest_version": 3,
  "name": "Xchajian",
  "short_name": "Xchajian",
  "version": "2.9.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "optional_permissions": [
    "webRequest",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "*://x.com/*",
    "https://*/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*/status/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://x.com/*"
      ],
      "js": [
        "injector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "lens/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "lens/content.js"
      ],
      "css": [
        "lens/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-tools.html",
        "page-tools.js",
        "page-export.html",
        "page-export.js",
        "page-tools.css"
      ],
      "matches": [
        "https://x.com/*"
      ]
    }
  ]
}
